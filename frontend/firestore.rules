rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Email-verified (Google sign-ins are verified by the provider).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    // value is a string within an inclusive length range
    function strLen(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    // Admin = verified sign-in with an admin email (keep in sync with ADMIN_EMAILS in src/constants.js).
    function isAdmin() {
      return verified() && request.auth.token.get('email', '').lower() in ['trishaan.agarwal@gmail.com'];
    }

    // ---------- users ----------
    // Private: email/phone/bookmarks are visible only to the owner. Other users
    // see the public subset in /profiles.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Email must be the caller's own Auth email (blocks spoofing on create
      // and on delete-then-recreate).
      allow create: if isOwner(userId)
        && strLen(request.resource.data.name, 1, 100)
        && request.resource.data.email == request.auth.token.get('email', '').lower();

      // Profile edits: email may only stay the same OR be synced to the
      // user's own verified Auth email (after a confirmed email change).
      allow update: if isOwner(userId)
        && (request.resource.data.email == resource.data.email
            || request.resource.data.email == request.auth.token.email)
        && strLen(request.resource.data.name, 1, 100)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 1000)
        && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 40)
        && (!('university' in request.resource.data) || request.resource.data.university.size() <= 120)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL.size() <= 600)
        && (!('bookmarks' in request.resource.data)
            || (request.resource.data.bookmarks is list && request.resource.data.bookmarks.size() <= 1000));

      // The owner may delete their own profile (account deletion).
      allow delete: if isOwner(userId);
    }

    // ---------- profiles (public name/photo; admin flag derived from auth) ----------
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'admin', 'deleted'])
        && strLen(request.resource.data.name, 1, 100)
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 600
        && request.resource.data.admin == isAdmin()
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool);
      allow delete: if false;
    }

    // Tombstones for deleted listings, so a deleted listing id can never be
    // re-created by someone else (bookmarks / shared links stay dead).
    match /deletedListings/{listingId} {
      allow read: if false;
      allow create: if signedIn()
        && get(/databases/$(database)/documents/listings/$(listingId)).data.userId == request.auth.uid
        && request.resource.data.keys().size() == 0;
      allow update, delete: if false;
    }

    // ---------- listings ----------
    // Public read; create only as yourself; update/delete only by owner.
    match /listings/{listingId} {
      allow read: if true;

      allow create: if verified()
        && request.resource.data.userId == request.auth.uid
        && strLen(request.resource.data.title, 1, 200)
        && request.resource.data.rent is number
        && request.resource.data.rent > 0
        && request.resource.data.rent < 100000
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/deletedListings/$(listingId))
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 12
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 5000)
        && (!('onBehalfOf' in request.resource.data)
            || request.resource.data.onBehalfOf == null
            || strLen(request.resource.data.onBehalfOf, 1, 60))
        && (!('contactLink' in request.resource.data)
            || request.resource.data.contactLink == null
            || strLen(request.resource.data.contactLink, 1, 200));

      // Owner-only edits; ownership and creation time are immutable, and the
      // same field constraints as create are re-validated to prevent tampering.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && strLen(request.resource.data.title, 1, 200)
        && request.resource.data.rent is number
        && request.resource.data.rent > 0
        && request.resource.data.rent < 100000
        && request.resource.data.status in ['active', 'taken']
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 12
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 5000)
        && (!('onBehalfOf' in request.resource.data)
            || request.resource.data.onBehalfOf == null
            || strLen(request.resource.data.onBehalfOf, 1, 60))
        && (!('contactLink' in request.resource.data)
            || request.resource.data.contactLink == null
            || strLen(request.resource.data.contactLink, 1, 200));

      // Must be deleted in a batch with its tombstone (see deleteListing()).
      allow delete: if signedIn() && resource.data.userId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/deletedListings/$(listingId));
    }

    // ---------- seekers (roommate posts, one per user, doc id = uid) ----------
    match /seekers/{userId} {
      allow read: if true;
      allow write: if verified() && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.updatedAt == request.time
        && strLen(request.resource.data.about, 1, 2000)
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 4
        && (!('budget' in request.resource.data)
            || (request.resource.data.budget is number
                && request.resource.data.budget >= 0
                && request.resource.data.budget < 100000))
        && (!('onBehalfOf' in request.resource.data)
            || request.resource.data.onBehalfOf == null
            || strLen(request.resource.data.onBehalfOf, 1, 60));
      allow delete: if isOwner(userId);
    }

    // ---------- reports ----------
    // Signed-in users can file a report; only admins read them (via console).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && strLen(request.resource.data.listingId, 1, 200)
        && strLen(request.resource.data.reason, 1, 1000);
    }

    // ---------- conversations ----------
    // Only the two participants can see or touch a conversation.
    match /conversations/{convId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      // Participants may only touch the last-message / read-state fields.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'readBy'])
        && (!('lastSenderId' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastSenderId == request.auth.uid)
        && strLen(request.resource.data.lastMessage, 0, 2000)
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() <= 2;

      // Creator is user1; user2 must really own the listing (or the seeker post)
      // the conversation is about, so nobody can pose as someone else's chat.
      allow create: if verified()
        && request.resource.data.user1Id == request.auth.uid
        && request.resource.data.user2Id is string
        && request.resource.data.user2Id != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.user2Id]
        && request.resource.data.listingId is string
        && (
          (request.resource.data.listingId == 'roommate:' + request.resource.data.user2Id
            && exists(/databases/$(database)/documents/seekers/$(request.resource.data.user2Id)))
          || (!request.resource.data.listingId.matches('roommate:.*')
            && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.userId == request.resource.data.user2Id)
        )
        && strLen(request.resource.data.listingTitle, 0, 250)
        && strLen(request.resource.data.user1Name, 0, 100)
        && strLen(request.resource.data.user2Name, 0, 100);

      allow delete: if false;

      // ---------- messages ----------
      match /messages/{msgId} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }
        allow read: if signedIn() && request.auth.uid in participants();

        allow create: if verified()
          && request.auth.uid in participants()
          && request.resource.data.senderId == request.auth.uid
          && strLen(request.resource.data.content, 1, 2000);

        allow update, delete: if false;
      }
    }
  }
}
